# Copy this to .env and fill in your values
# NEVER commit .env to git

# Supabase — get from supabase.com > project > settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY

# Google OAuth — get from console.cloud.google.com > OAuth 2.0 Client IDs
# Create an "iOS" client and an "Android" client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
